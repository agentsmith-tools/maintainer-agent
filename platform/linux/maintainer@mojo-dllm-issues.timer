[Unit]
Description=maintainer: mojo-dllm issues (timer)

[Timer]
# Fires daily. The real cadence is MIN_HOURS_issues in profiles/mojo-dllm/profile.env,
# which run.sh enforces on every platform.
OnCalendar=*-*-* 14:17:00
OnCalendar=*-*-* 19:17:00
Persistent=true
RandomizedDelaySec=300
Unit=maintainer@mojo-dllm-issues.service

[Install]
WantedBy=timers.target
